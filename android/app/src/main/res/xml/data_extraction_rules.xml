<?xml version="1.0" encoding="utf-8"?>
<!-- Do not back up or transfer the signed-in session (Keychain-equivalent behaviour). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
