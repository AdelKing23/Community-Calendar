import SwiftUI

struct SupportAdminScreen: View {
    @EnvironmentObject private var userSessionStore: UserSessionStore

    private let supportService: OwnerEventReviewing = SupabaseEventService()
    @State private var accessState = SupportAccessState.checking

    var body: some View {
        ZStack {
            PCCScreenBackground()

            switch accessState {
            case .checking:
                ProgressView("Checking Support access")
                    .font(.headline.weight(.bold))
                    .tint(PCCTheme.leafGreen)
                    .padding(20)
                    .pccCardStyle()
            case .allowed:
                SupportDashboard(
                    supportService: supportService
                ) {
                    userSessionStore.signOut()
                }
            case .denied:
                SupportAccessUnavailableScreen(
                    email: userSessionStore.email,
                    isSignedIn: userSessionStore.isSignedIn,
                    isEmailVerified: userSessionStore.isEmailVerified
                )
            }
        }
        .navigationTitle("Support")
        .navigationBarTitleDisplayMode(.inline)
        .task(id: userSessionStore.email ?? "signed-out") {
            await verifySupportAccess()
        }
    }

    @MainActor
    private func verifySupportAccess() async {
        accessState = .checking

        await userSessionStore.refreshIfNeeded()
        guard let activeSession = userSessionStore.session else {
            accessState = .denied
            return
        }

        do {
            let isAllowed = try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken)
            accessState = isAllowed ? .allowed : .denied
        } catch {
            accessState = .denied
        }
    }
}

private enum SupportAccessState {
    case checking
    case allowed
    case denied
}

struct SupportAccessUnavailableScreen: View {
    let email: String?
    let isSignedIn: Bool
    let isEmailVerified: Bool

    var body: some View {
        ScrollView(showsIndicators: false) {
            VStack(alignment: .leading, spacing: 18) {
                VStack(alignment: .leading, spacing: 12) {
                    Text("Review Queue")
                        .font(.system(size: 38, weight: .black, design: .serif))
                        .foregroundStyle(PCCTheme.ink)

                    Text("Support tools are only available to authorised listing reviewers.")
                        .font(.title3.weight(.medium))
                        .foregroundStyle(PCCTheme.ink.opacity(0.68))
                        .lineSpacing(3)
                }
                .padding(20)
                .pccCardStyle()

                VStack(alignment: .leading, spacing: 12) {
                    Label(statusTitle, systemImage: statusIcon)
                        .font(.headline.weight(.black))
                        .foregroundStyle(PCCTheme.ink)

                    Text(statusMessage)
                        .font(.body.weight(.medium))
                        .foregroundStyle(PCCTheme.ink.opacity(0.64))
                        .lineSpacing(3)

                    if let email {
                        Text(email)
                            .font(.footnote.weight(.bold))
                            .foregroundStyle(PCCTheme.leafGreen)
                            .padding(.horizontal, 10)
                            .padding(.vertical, 6)
                            .background(PCCTheme.leafGreen.opacity(0.10), in: Capsule())
                    }
                }
                .padding(16)
                .frame(maxWidth: .infinity, alignment: .leading)
                .background(PCCTheme.cream.opacity(0.70), in: RoundedRectangle(cornerRadius: PCCTheme.smallRadius, style: .continuous))
            }
            .padding(.horizontal, 16)
            .padding(.top, PCCKeyboardSpacing.standardTopPadding)
            .padding(.bottom, PCCKeyboardSpacing.standardBottomPadding)
        }
    }

    private var statusIcon: String {
        if !isSignedIn { return "person.crop.circle.badge.exclamationmark" }
        if !isEmailVerified { return "envelope.badge.shield.half.filled" }
        return "lock.shield"
    }

    private var statusTitle: String {
        if !isSignedIn { return "Sign in first" }
        if !isEmailVerified { return "Verify this email first" }
        return "Support access has not been added"
    }

    private var statusMessage: String {
        if !isSignedIn {
            return "Sign in from Settings with the account that should review listings."
        }

        if !isEmailVerified {
            return "Support accounts must confirm their email before private review tools can open."
        }

        return "This account is signed in, but it is not active in the Support access list. Add it from Supabase before using review tools."
    }
}

struct SupportDashboard: View {
    struct ReviewAction: Identifiable {
        enum Kind {
            case approve
            case reject
        }

        let id = UUID()
        let request: EventChangeRequest
        let kind: Kind
    }

    struct MemberReviewAction: Identifiable {
        enum Kind {
            case approve
            case reject
            case suspend
        }

        let id = UUID()
        let profile: BusinessProfileRecord
        let kind: Kind
    }

    let supportService: OwnerEventReviewing
    let onLogout: () -> Void

    @EnvironmentObject private var userSessionStore: UserSessionStore
    @State private var events: [LocalEvent] = []
    @State private var isLoading = false
    @State private var loadError: String?
    @State private var supportDataIssues: [String] = []
    @State private var actionMessage: String?
    @State private var updatingEventID: UUID?
    @State private var changeRequests: [EventChangeRequest] = []
    @State private var updatingRequestID: UUID?
    @State private var selectedReviewAction: ReviewAction?
    @State private var supportRequests: [SupportRequestRecord] = []
    @State private var updatingSupportRequestID: UUID?
    @State private var selectedSupportRequest: SupportRequestRecord?
    @State private var eventReports: [EventReportRecord] = []
    @State private var updatingEventReportID: UUID?
    @State private var memberProfiles: [BusinessProfileRecord] = []
    @State private var memberSubscriptions: [BusinessSubscriptionRecord] = []
    @State private var updatingMemberProfileID: UUID?
    @State private var selectedMemberReviewAction: MemberReviewAction?

    private var pendingEvents: [LocalEvent] {
        events
            .filter { $0.listingStatus == .pendingReview }
            .sorted { $0.createdAt > $1.createdAt }
    }

    private var publishedEvents: [LocalEvent] {
        events
            .filter { $0.listingStatus == .published }
            .sorted { $0.startDate < $1.startDate }
    }

    private var rejectedEvents: [LocalEvent] {
        events
            .filter { $0.listingStatus == .rejected }
            .sorted { ($0.updatedAt ?? $0.createdAt) > ($1.updatedAt ?? $1.createdAt) }
    }

    private var archivedEvents: [LocalEvent] {
        events
            .filter { $0.listingStatus == .archived }
            .sorted { ($0.updatedAt ?? $0.createdAt) > ($1.updatedAt ?? $1.createdAt) }
    }

    private var sortedChangeRequests: [EventChangeRequest] {
        changeRequests.sorted {
            if $0.status != $1.status {
                return $0.status == .pending
            }

            return $0.createdAt > $1.createdAt
        }
    }

    private var sortedSupportRequests: [SupportRequestRecord] {
        supportRequests.sorted {
            if $0.status != $1.status {
                return $0.status.sortPriority < $1.status.sortPriority
            }

            return $0.createdAt > $1.createdAt
        }
    }

    private var sortedEventReports: [EventReportRecord] {
        eventReports.sorted {
            if $0.status != $1.status {
                return $0.status.sortPriority < $1.status.sortPriority
            }

            return $0.createdAt > $1.createdAt
        }
    }

    private var sortedMemberProfiles: [BusinessProfileRecord] {
        memberProfiles.sorted(by: { lhs, rhs in
            if lhs.memberStatus.supportSortPriority != rhs.memberStatus.supportSortPriority {
                return lhs.memberStatus.supportSortPriority < rhs.memberStatus.supportSortPriority
            }

            return lhs.createdAt > rhs.createdAt
        })
    }

    var body: some View {
        ScrollView(showsIndicators: false) {
            VStack(alignment: .leading, spacing: 18) {
                SupportHeaderCard(onLogout: onLogout)

                if let actionMessage {
                    Label(actionMessage, systemImage: "checkmark.seal.fill")
                        .font(.subheadline.weight(.bold))
                        .foregroundStyle(PCCTheme.leafGreen)
                        .padding(14)
                        .frame(maxWidth: .infinity, alignment: .leading)
                        .background(PCCTheme.leafGreen.opacity(0.08), in: RoundedRectangle(cornerRadius: PCCTheme.smallRadius, style: .continuous))
                }

                if !supportDataIssues.isEmpty {
                    SupportPanel(title: "Support Checks", icon: "exclamationmark.triangle.fill") {
                        VStack(alignment: .leading, spacing: 10) {
                            ForEach(supportDataIssues, id: \.self) { issue in
                                Text(issue)
                                    .font(.body.weight(.medium))
                                    .foregroundStyle(PCCTheme.pohutukawaRed)
                                    .fixedSize(horizontal: false, vertical: true)
                            }

                            Button("Try Again") {
                                Task { await loadOwnerEvents() }
                            }
                            .font(.headline.weight(.black))
                            .foregroundStyle(PCCTheme.leafGreen)
                        }
                    }
                }

                if isLoading {
                    SupportPanel(title: "Loading Listings", icon: "arrow.clockwise") {
                        ProgressView()
                            .tint(PCCTheme.pohutukawaOrange)
                    }
                } else if let loadError {
                    SupportPanel(title: "Support Data", icon: "wifi.exclamationmark") {
                        VStack(alignment: .leading, spacing: 12) {
                            Text(loadError)
                                .font(.body.weight(.medium))
                                .foregroundStyle(PCCTheme.pohutukawaRed)

                            Button("Try Again") {
                                Task { await loadOwnerEvents() }
                            }
                            .font(.headline.weight(.black))
                            .foregroundStyle(PCCTheme.leafGreen)
                        }
                    }
                }

                SupportRequestsInboxPanel(
                    requests: sortedSupportRequests,
                    updatingRequestID: updatingSupportRequestID,
                    onReply: { request in
                        selectedSupportRequest = request
                    },
                    onClose: { request in
                        Task {
                            await updateSupportRequest(
                                request,
                                status: .closed,
                                supportNote: request.supportNote
                            )
                        }
                    }
                )

                EventReportsInboxPanel(
                    reports: sortedEventReports,
                    updatingReportID: updatingEventReportID,
                    onClose: { report in
                        Task { await updateEventReport(report, status: .closed) }
                    },
                    onDismiss: { report in
                        Task { await updateEventReport(report, status: .dismissed) }
                    }
                )

                MemberApplicationsPanel(
                    profiles: sortedMemberProfiles,
                    subscriptionsByProfileID: subscriptionsByProfileID,
                    updatingProfileID: updatingMemberProfileID,
                    onApprove: { profile in
                        selectedMemberReviewAction = MemberReviewAction(profile: profile, kind: .approve)
                    },
                    onReject: { profile in
                        selectedMemberReviewAction = MemberReviewAction(profile: profile, kind: .reject)
                    },
                    onSuspend: { profile in
                        selectedMemberReviewAction = MemberReviewAction(profile: profile, kind: .suspend)
                    }
                )

                PendingListingsReviewPanel(
                    events: pendingEvents,
                    updatingEventID: updatingEventID,
                    onSetStatus: { event, status in
                        Task { await update(event, to: status) }
                    }
                )

                ChangeRequestsReviewPanel(
                    requests: sortedChangeRequests,
                    updatingRequestID: updatingRequestID,
                    onApprove: { request in
                        selectedReviewAction = ReviewAction(request: request, kind: .approve)
                    },
                    onReject: { request in
                        selectedReviewAction = ReviewAction(request: request, kind: .reject)
                    }
                )

                SupportEventListPanel(title: "Published Events", icon: "calendar.badge.checkmark", events: publishedEvents, defaultExpanded: false)
                SupportEventListPanel(title: "Rejected", icon: "xmark.seal", events: rejectedEvents, defaultExpanded: false)
                SupportEventListPanel(title: "Archived", icon: "archivebox", events: archivedEvents, defaultExpanded: false)

                Text("User edits and removal requests are reviewed here. Published listings stay unchanged until Support applies a request.")
                    .pccSettingsFooterStyle()
                    .padding(.horizontal, 6)
            }
            .padding(.horizontal, 16)
            .padding(.top, PCCKeyboardSpacing.standardTopPadding)
            .padding(.bottom, PCCKeyboardSpacing.formBottomPadding)
        }
        .pccBottomKeyboardInset(PCCKeyboardSpacing.formBottomInset)
        .pccScrollableKeyboardDismiss()
        .pccDismissesKeyboardOnTap()
        .task {
            await loadOwnerEvents()
        }
        .refreshable {
            await loadOwnerEvents()
        }
        .sheet(item: $selectedReviewAction) { action in
            SupportReviewDecisionSheet(
                request: action.request,
                kind: action.kind
            ) { reason, note in
                switch action.kind {
                case .approve:
                    await approve(action.request, reason: reason, note: note)
                case .reject:
                    await reject(action.request, reason: reason, note: note)
                }
            }
        }
        .sheet(item: $selectedSupportRequest) { request in
            SupportRequestReplySheet(request: request) { status, note in
                await updateSupportRequest(request, status: status, supportNote: note)
            }
        }
        .sheet(item: $selectedMemberReviewAction) { action in
            MemberProfileDecisionSheet(profile: action.profile, kind: action.kind) { reason, note in
                switch action.kind {
                case .approve:
                    await updateMemberProfile(action.profile, status: .approved, reason: nil, supportNote: note)
                case .reject:
                    await updateMemberProfile(action.profile, status: .rejected, reason: reason, supportNote: note)
                case .suspend:
                    await updateMemberProfile(action.profile, status: .suspended, reason: reason, supportNote: note)
                }
            }
        }
    }

    @MainActor
    private func loadOwnerEvents() async {
        guard let session = userSessionStore.session else {
            events = []
            changeRequests = []
            supportRequests = []
            memberProfiles = []
            memberSubscriptions = []
            isLoading = false
            return
        }

        isLoading = events.isEmpty
        loadError = nil
        supportDataIssues = []

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  activeSession.userID == session.userID,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }
            let requestContext = userSessionStore.captureAccountContext()

            var issues: [String] = []
            var loadedEvents: [LocalEvent] = []
            var loadedChangeRequests: [EventChangeRequest] = []
            var loadedSupportRequests: [SupportRequestRecord] = []
            var loadedEventReports: [EventReportRecord] = []
            var loadedMemberProfiles: [BusinessProfileRecord] = []
            var loadedMemberSubscriptions: [BusinessSubscriptionRecord] = []

            do {
                loadedEvents = try await supportService.fetchOwnerEvents(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Listings could not be loaded: \(error.pccUserFacingMessage)")
            }

            do {
                loadedChangeRequests = try await supportService.fetchSupportChangeRequests(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Change requests could not be loaded: \(error.pccUserFacingMessage)")
            }

            do {
                loadedSupportRequests = try await supportService.fetchSupportRequests(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Support messages could not be loaded: \(error.pccUserFacingMessage)")
            }

            do {
                loadedEventReports = try await supportService.fetchEventReportsForSupport(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Listing reports could not be loaded: \(error.pccUserFacingMessage)")
            }

            do {
                loadedMemberProfiles = try await supportService.fetchMemberProfilesForSupport(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Member applications could not be loaded: \(error.pccUserFacingMessage)")
            }

            do {
                loadedMemberSubscriptions = try await supportService.fetchMemberSubscriptionsForSupport(accessToken: activeSession.accessToken)
            } catch {
                issues.append("Member subscription records could not be loaded: \(error.pccUserFacingMessage)")
            }

            guard userSessionStore.isCurrent(requestContext) else { return }
            events = loadedEvents
            changeRequests = loadedChangeRequests
            supportRequests = loadedSupportRequests
            eventReports = loadedEventReports
            memberProfiles = loadedMemberProfiles
            memberSubscriptions = loadedMemberSubscriptions
            supportDataIssues = issues
            isLoading = false
        } catch {
            guard userSessionStore.session?.userID == session.userID else { return }
            isLoading = false
            loadError = "Support access could not be confirmed. If your session expired, log out and sign in again."
        }
    }

    @MainActor
    private func update(_ event: LocalEvent, to status: ListingStatus) async {
        updatingEventID = event.id
        actionMessage = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }
            let requestContext = userSessionStore.captureAccountContext()

            try await supportService.updateEventStatus(id: event.id, status: status, accessToken: activeSession.accessToken)
            guard userSessionStore.isCurrent(requestContext) else { return }
            actionMessage = "\(event.title) moved to \(status.supportLabel)."
            updatingEventID = nil
            await loadOwnerEvents()
        } catch {
            updatingEventID = nil
            loadError = "Could not update this listing. If your session expired, log out and sign in again."
        }
    }

    @MainActor
    private func approve(_ request: EventChangeRequest, reason: EventReviewReason, note: String?) async {
        updatingRequestID = request.id
        actionMessage = nil
        selectedReviewAction = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }

            try await supportService.supportApproveChangeRequest(
                request,
                reviewReason: reason,
                supportNote: note,
                accessToken: activeSession.accessToken
            )
            actionMessage = "\(request.supportTitle) applied."
            updatingRequestID = nil
            await loadOwnerEvents()
        } catch {
            updatingRequestID = nil
            loadError = "Could not apply this request. Check the request details and try again."
        }
    }

    @MainActor
    private func reject(_ request: EventChangeRequest, reason: EventReviewReason, note: String?) async {
        updatingRequestID = request.id
        actionMessage = nil
        selectedReviewAction = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }

            try await supportService.supportRejectChangeRequest(
                id: request.id,
                reviewReason: reason,
                supportNote: note,
                accessToken: activeSession.accessToken
            )
            actionMessage = "\(request.supportTitle) rejected."
            updatingRequestID = nil
            await loadOwnerEvents()
        } catch {
            updatingRequestID = nil
            loadError = "Could not reject this request. If your session expired, log out and sign in again."
        }
    }

    @MainActor
    private func updateSupportRequest(_ request: SupportRequestRecord, status: SupportRequestStatus, supportNote: String?) async {
        updatingSupportRequestID = request.id
        actionMessage = nil
        selectedSupportRequest = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }

            try await supportService.updateSupportRequest(
                id: request.id,
                status: status,
                supportNote: supportNote,
                accessToken: activeSession.accessToken
            )
            actionMessage = "Support request \(request.id.uuidString.prefix(8).uppercased()) updated."
            updatingSupportRequestID = nil
            await loadOwnerEvents()
        } catch {
            updatingSupportRequestID = nil
            loadError = "Could not update this support request. If your session expired, log out and sign in again."
        }
    }

    @MainActor
    private func updateEventReport(_ report: EventReportRecord, status: EventReportStatus) async {
        updatingEventReportID = report.id
        actionMessage = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }

            try await supportService.updateEventReport(
                id: report.id,
                status: status,
                supportNote: nil,
                accessToken: activeSession.accessToken
            )
            actionMessage = "Listing report \(report.id.uuidString.prefix(8).uppercased()) moved to \(status.label)."
            updatingEventReportID = nil
            await loadOwnerEvents()
        } catch {
            updatingEventReportID = nil
            loadError = "Could not update this listing report. If your session expired, log out and sign in again."
        }
    }

    @MainActor
    private func updateMemberProfile(_ profile: BusinessProfileRecord, status: BusinessProfileStatus, reason: String?, supportNote: String?) async {
        updatingMemberProfileID = profile.id
        actionMessage = nil
        selectedMemberReviewAction = nil

        do {
            await userSessionStore.refreshIfNeeded()
            guard let activeSession = userSessionStore.session,
                  try await supportService.currentUserHasSupportAccess(accessToken: activeSession.accessToken) else {
                throw SupabaseServiceError.authFailed
            }
            let requestContext = userSessionStore.captureAccountContext()

            try await supportService.updateMemberProfileStatus(
                id: profile.id,
                status: status,
                reason: reason,
                supportNote: supportNote,
                accessToken: activeSession.accessToken
            )
            guard userSessionStore.isCurrent(requestContext) else { return }
            if status != .approved {
                let moderationReason = reason?.trimmingCharacters(in: .whitespacesAndNewlines).nilIfEmpty
                    ?? supportNote?.trimmingCharacters(in: .whitespacesAndNewlines).nilIfEmpty
                    ?? "Membership moved to \(status.rawValue)"
                _ = try await supportService.supportUnpublishMemberPublicProfile(
                    id: profile.id,
                    reason: moderationReason,
                    accessToken: activeSession.accessToken
                )
                guard userSessionStore.isCurrent(requestContext) else { return }
            }
            actionMessage = "\(profile.businessName) moved to \(status.displayTitle)."
            updatingMemberProfileID = nil
            #if DEBUG
            print("[SupportApproval] updateMemberProfile failed: \(error)")
            print("[SupportApproval] detail: \(error.pccUserFacingMessage)")
            #endif
            await loadOwnerEvents()
        } catch {
            updatingMemberProfileID = nil
            #if DEBUG
            print("[SupportApproval] updateMemberProfile failed: \(error)")
            print("[SupportApproval] detail: \(error.pccUserFacingMessage)")
            #endif
            loadError = "Could not update this member profile. If your session expired, log out and sign in again."
        }
    }

    private var subscriptionsByProfileID: [UUID: [BusinessSubscriptionRecord]] {
        Dictionary(grouping: memberSubscriptions, by: \.businessProfileID)
            .mapValues { records in
                records.sorted {
                    if $0.isCurrentlyActive != $1.isCurrentlyActive {
                        return $0.isCurrentlyActive
                    }

                    return $0.updatedAt > $1.updatedAt
                }
            }
    }
}

