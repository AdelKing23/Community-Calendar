private extension BusinessProfileStatus {
    var supportSortPriority: Int {
        switch self {
        case .pendingReview: return 0
        case .rejected: return 1
        case .suspended: return 2
        case .approved: return 3
        case .archived: return 4
        }
    }

    var supportTint: Color {
        switch self {
        case .pendingReview: return PCCTheme.pohutukawaOrange
        case .approved: return PCCTheme.leafGreen
        case .rejected: return PCCTheme.pohutukawaOrange
        case .suspended: return PCCTheme.pohutukawaRed
        case .archived: return PCCTheme.ink.opacity(0.62)
        }
    }
}

struct SupportRequestsInboxPanel: View {
