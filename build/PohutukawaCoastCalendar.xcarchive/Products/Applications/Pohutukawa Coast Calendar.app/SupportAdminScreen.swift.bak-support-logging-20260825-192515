struct MemberProfileDecisionSheet: View {
    let profile: BusinessProfileRecord
    let kind: SupportDashboard.MemberReviewAction.Kind
    let onSubmit: (String?, String?) async -> Void

    @Environment(\.dismiss) private var dismiss
    @State private var reason = ""
    @State private var supportNote = ""
    @State private var isSubmitting = false

    private var title: String {
        switch kind {
        case .approve:
            return "Approve Member"
        case .reject:
            return "Request Member Changes"
        case .suspend:
            return "Suspend Member"
        }
    }

    private var fieldTitle: String {
        switch kind {
        case .approve:
            return "Support note"
        case .reject:
            return "Changes needed"
        case .suspend:
            return "Suspension reason"
        }
    }

    private var buttonTitle: String {
        switch kind {
        case .approve:
            return "Approve Member"
        case .reject:
            return "Send Request"
        case .suspend:
            return "Suspend Member"
        }
    }

    private var helperText: String {
        switch kind {
        case .approve:
            return "Optional. Add a short welcome or next step if it helps. Leave blank for a normal approval."
        case .reject:
            return "Optional, but recommended. Tell them what to change so they can apply again without losing the thread."
        case .suspend:
            return "Optional, but recommended. Explain why publishing is paused and what Support needs next."
        }
    }

    private var actionColor: Color {
        switch kind {
        case .approve:
            return PCCTheme.leafGreen
        case .reject:
            return PCCTheme.pohutukawaOrange
        case .suspend:
            return PCCTheme.pohutukawaRed
        }
    }

    private var decisionReason: String? {
        switch kind {
        case .approve:
            return nil
        case .reject, .suspend:
            return reason.nilIfEmpty
        }
    }

    private var visibleSupportNote: String? {
        switch kind {
        case .approve:
            return supportNote.nilIfEmpty
        case .reject, .suspend:
            return supportNote.nilIfEmpty ?? reason.nilIfEmpty
        }
    }

    var body: some View {
        NavigationStack {
            ScrollView(showsIndicators: false) {
                VStack(alignment: .leading, spacing: 18) {
