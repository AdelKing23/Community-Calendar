                    .font(.caption.weight(.black))
                    .foregroundStyle(request.status.supportTint)
                    .padding(.horizontal, 10)
                    .padding(.vertical, 7)
                    .background(request.status.supportTint.opacity(0.10), in: Capsule())
            }

