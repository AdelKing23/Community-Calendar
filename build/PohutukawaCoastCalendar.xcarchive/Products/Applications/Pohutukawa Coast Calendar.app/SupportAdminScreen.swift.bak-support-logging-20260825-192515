                    .foregroundStyle(PCCTheme.ink.opacity(0.68))
            } else {
                VStack(spacing: 12) {
                    ForEach(requests.prefix(12)) { request in
                        SupportRequestAdminCard(
                            request: request,
                            isUpdating: updatingRequestID == request.id,
                            onReply: {
                                onReply(request)
                            },
                            onClose: {
                                onClose(request)
                            }
                        )
                    }
                }
            }
        }
    }
}

struct SupportRequestAdminCard: View {
    let request: SupportRequestRecord
    let isUpdating: Bool
    let onReply: () -> Void
    let onClose: () -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 12) {
            HStack(alignment: .top, spacing: 10) {
                VStack(alignment: .leading, spacing: 5) {
                    Text(request.topic)
                        .font(.title3.weight(.black))
                        .foregroundStyle(PCCTheme.ink)

                    Text("Reference \(request.id.uuidString.prefix(8).uppercased()) · \(request.createdAt.formatted(.dateTime.day().month().hour().minute()))")
                        .font(.caption.weight(.bold))
                        .foregroundStyle(PCCTheme.ink.opacity(0.54))
                }

                Spacer()

                Text(request.status.label)
                    .font(.caption.weight(.black))
                    .foregroundStyle(request.status.tint)
